{
    "hooks": {
        "SessionStart": [
            {
                "type": "command",
                "command": "node .github/hooks/scripts/issue-workflow-policy.mjs",
                "windows": "node.exe .github/hooks/scripts/issue-workflow-policy.mjs",
                "timeout": 10
            }
        ],
        "UserPromptSubmit": [
            {
                "type": "command",
                "command": "node .github/hooks/scripts/issue-workflow-policy.mjs",
                "windows": "node.exe .github/hooks/scripts/issue-workflow-policy.mjs",
                "timeout": 10
            }
        ],
        "PreToolUse": [
            {
                "type": "command",
                "command": "node .github/hooks/scripts/issue-workflow-policy.mjs",
                "windows": "node.exe .github/hooks/scripts/issue-workflow-policy.mjs",
                "timeout": 10
            }
        ],
        "Stop": [
            {
                "type": "command",
                "command": "node .github/hooks/scripts/issue-workflow-policy.mjs",
                "windows": "node.exe .github/hooks/scripts/issue-workflow-policy.mjs",
                "timeout": 10
            }
        ]
    }
}
